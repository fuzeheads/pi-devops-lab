TZ=Europe/Amsterdam
PIHOLE_IMAGE=pihole/pihole:latest
PLATFORM=linux/arm64               # Raspberry Pi 4 with 64-bit OS

# Web/API admin password (Pi-hole v6 syntax).
# NOTE: v6 ignores the old v5 `WEBPASSWORD` variable — it must be
# FTLCONF_webserver_api_password or the password is silently not applied.
# In CI this is injected from the PIHOLE_WEBPASSWORD GitHub Actions secret.
# Never commit a real value.
FTLCONF_webserver_api_password=__CHANGE_ME__
