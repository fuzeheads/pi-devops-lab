#!/bin/sh
# labwc autostart — DAKboard kiosk for the living-room display.
# Installed to ~/.config/labwc/autostart by bootstrap/pipeline.
# __DAKBOARD_URL__ is injected at deploy time (never committed).

swaybg -c '#000000' &
sleep 3
exec chromium \
  --kiosk \
  --noerrdialogs \
  --disable-infobars \
  --incognito \
  --disable-session-crashed-bubble \
  --check-for-update-interval=604800 \
  --password-store=basic \
  --ozone-platform=wayland \
  "__DAKBOARD_URL__"